{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PartyLink",
  "version": "0.3.0",
  "identifier": "gg.partylink.desktop",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "https://partylink.adrianpaintaway.workers.dev"
  },
  "app": {
    "windows": [
      {
        "title": "PartyLink",
        "width": 1280,
        "height": 820,
        "minWidth": 420,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "PartyLink",
    "shortDescription": "Party games with your friends",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
