{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the PartyLink web app may ask the desktop app to do: scan the player's games folder, and install and start emulators.",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "https://partylink.adrianpaintaway.workers.dev/*"
    ]
  },
  "permissions": [
    "core:default",
    "allow-get-games-folder",
    "allow-choose-games-folder",
    "allow-scan-games",
    "allow-emulator-installed",
    "allow-install-emulator",
    "allow-needs-vc-runtime",
    "allow-launch-dolphin",
    "allow-emulator-running",
    "allow-read-dolphin-room-code",
    "allow-launch-retroarch",
    "allow-find-retroarch-room",
    "allow-launch-mupen",
    "allow-read-mupen-room-code",
    "allow-copy-mupen-room-code"
  ]
}
