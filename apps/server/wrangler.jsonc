{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "partylink",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // The web app is served from the same address as the API, so phones and
  // PCs only ever need one URL. Requests under /api/ reach the Worker first.
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  // The free plan requires SQLite-backed Durable Objects.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "observability": { "enabled": true }
}
